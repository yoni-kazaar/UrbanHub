# Copier ce fichier en ".env" à la racine du dépôt, puis remplir les valeurs.
# Le fichier .env ne doit JAMAIS être commité.

# En local : http://localhost:9100 (ports décalés pour éviter les conflits)
# Sur le VPS : l'URL HTTPS fournie par D
MINIO_ENDPOINT=http://localhost:9100

# En local : les identifiants du conteneur MinIO (minioadmin / minioadmin par défaut)
# Sur le VPS : les clés du compte "meteo" fournies par D
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
