{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::bronze", "arn:aws:s3:::silver", "arn:aws:s3:::gold"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::bronze", "arn:aws:s3:::silver"],
      "Condition": {"StringLike": {"s3:prefix": ["pollution", "pollution/*"]}}
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::gold"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::bronze/pollution/*",
        "arn:aws:s3:::silver/pollution/*",
        "arn:aws:s3:::gold/pollution/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::gold/*"]
    }
  ]
}
