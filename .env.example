# Copier ce fichier en .env (jamais commité) et remplir les valeurs.

# --- OpenAQ (Partie 3) ---
# Clé gratuite sur https://explore.openaq.org
OPENAQ_API_KEY=

# --- MinIO ---
# Vide = écriture dans un dossier local (partie3_pollution/data_lake)
# Dev avec le MinIO local du docker-compose : minio-local:9000
# Production : l'adresse HTTPS du MinIO du VPS fournie par D (ex. https://minio.mon-domaine.fr)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Collecteur pollution (Partie 3) ---
INTERVALLE_MINUTES=15
# Sur le VPS : false -> une écriture MinIO qui échoue s'arrête au lieu de partir en secours dans un dossier local
SECOURS_LOCAL=true
